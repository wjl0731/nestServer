# 运行环境
NODE_ENV=production

# 服务端口
PORT=3000

# 允许的前端 origin（多个用逗号分隔），生产环境不要写 *
CORS_ORIGIN=*

# 默认模型 provider：qwen | deepseek | openai
DEFAULT_PROVIDER=qwen
DEFAULT_MODEL=qwen-turbo

# ===== 通义千问 (DashScope OpenAI-compatible) =====
QWEN_API_KEY=sk-fe19f0afed6c418a807e0b5c824e318a
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== DeepSeek =====
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== OpenAI =====
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=admin888
MYSQL_DATABASE=nest_app
MYSQL_SYNCHRONIZE=true

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=admin888
REDIS_DB=0

# ===== JWT =====
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRES_IN=7d

# ===== SMTP =====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=qq1624679067@gmail.com
SMTP_PASS=bfmdbdahilcucktg
SMTP_FROM_NAME=NestApp

# 验证码 / 邮件验证码过期时间（秒）
