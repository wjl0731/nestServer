# Coze（扣子）- PAT 在 https://www.coze.cn/open/oauth/pats 创建，bot_id 为智能体 ID
COZE_API_KEY=
COZE_BASE_URL=https://api.coze.cn
COZE_BOT_ID=
COZE_USER_ID=nest-user

# 撮合接口 /api/match 的访问令牌（供 Coze 插件调用）。
# 留空=不校验（仅本地调试）；公网暴露时务必设置，并在 Coze 插件里配 Bearer 鉴权。
MATCH_API_TOKEN=

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=admin888
MYSQL_DATABASE=nest_app
MYSQL_SYNCHRONIZE=true

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=admin888
REDIS_DB=0

# Token Session
TOKEN_TTL=7d
# 兼容旧配置，未设置 TOKEN_TTL 时会回退到 JWT_EXPIRES_IN
JWT_EXPIRES_IN=7d

# SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
